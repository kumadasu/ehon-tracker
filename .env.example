# Google OAuth Client ID (from Google Cloud Console)
# Required for Drive backup/sync and Google Calendar integration.
# Leave empty to run in localStorage-only mode (no sign-in).
VITE_GOOGLE_CLIENT_ID=

# Google Books API Key (from Google Cloud Console > APIs & Services > Credentials)
# Required to avoid hitting the shared quota limit on the Books API.
# Enable "Books API" in the GCP project, then create an API key (no restrictions needed for personal use).
VITE_GOOGLE_BOOKS_API_KEY=
